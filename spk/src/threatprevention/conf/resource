{
	"indexdb": {
		"app-index": {
			"conf-relpath": "ui/index.conf",
			"db-relpath": "indexdb/appindexdb"
		},
		"help-index": {
			"conf-relpath": "ui/helptoc.conf",
			"db-relpath": "indexdb/helpindexdb"
		}
	},
	"web-config": {
		"nginx-static-config": {
			"enable": [
				{
					"type": "dsm",
					"relpath": "etc/nginx/dsm-tpsweb.conf"
				},
				{
					"type": "www",
					"relpath": "etc/nginx/dsm-tpsweb.conf"
				}
			]
		}
	},
	"data-share": {
		"shares": [
			{
				"name": "ThreatPrevention",
				"permission": {
					"rw": ["ThreatPrevention"]
				}
			}
		]
	}
}
