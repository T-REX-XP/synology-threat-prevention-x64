#!/bin/sh
# Unpack ET rules once into the package var area if missing.
PKGDEST="${SYNOPKG_PKGDEST:-/var/packages/ThreatPrevention/target}"
PKGVAR="/var/packages/ThreatPrevention/var"
RULES_TGZ="${PKGDEST}/etc/rules/emerging.rules.tar.gz"
RULES_DIR="${PKGDEST}/etc/rules/suricata"

mkdir -p "${PKGVAR}/log" "${PKGVAR}/rules" "${PKGVAR}/export" "${RULES_DIR}"
mkdir -p "${PKGDEST}/indexdb/helpindexdb" "${PKGDEST}/indexdb/appindexdb"
# DSM does not wipe extra files in target/ui. Community leftovers keep the Start Menu
# on SYNO.SDS.ThreatPrevention.Application instead of the official window.
rm -f "${PKGDEST}/ui/threatprevention.js" \
	"${PKGDEST}/ui/index.html" \
	"${PKGDEST}/ui/app.js" \
	"${PKGDEST}/ui/app.css" \
	"${PKGDEST}/ui/status.html" \
	"${PKGDEST}/ui/tps-bridge.js"
rm -rf "${PKGDEST}/ui/bridge"
if [ -f "${RULES_TGZ}" ] && [ ! -d "${RULES_DIR}/rules" ]; then
	tar -xzf "${RULES_TGZ}" -C "${RULES_DIR}"
	rm -f "${RULES_DIR}/rules/emerging-deleted.rules" \
		"${RULES_DIR}/rules/botcc.portgrouped.rules"
	cp -f "${PKGDEST}/etc/rules/syno-custom-events.rules" "${RULES_DIR}/rules/" 2>/dev/null || true
	cp -f "${PKGDEST}/etc/rules/classification.config" "${RULES_DIR}/" 2>/dev/null || true
	cp -f "${PKGDEST}/etc/rules/reference.config" "${RULES_DIR}/" 2>/dev/null || true
fi
PKGETC="/var/packages/ThreatPrevention/etc"
mkdir -p "${PKGETC}/geoip"
if [ ! -f "${PKGETC}/geoip/GeoIP.dat" ]; then
	for src in /usr/share/GeoIP/GeoIP.dat /usr/share/GeoIP/GeoLiteCountry.dat /usr/share/geoip/GeoIP.dat; do
		if [ -f "${src}" ]; then
			ln -sfn "${src}" "${PKGETC}/geoip/GeoIP.dat"
			break
		fi
	done
fi
if [ ! -s "${PKGVAR}/rules/suricata.rules" ] && [ -d "${RULES_DIR}/rules" ]; then
	cat "${RULES_DIR}/rules/"*.rules > "${PKGVAR}/rules/suricata.rules" 2>/dev/null || true
	cp -f "${PKGVAR}/rules/suricata.rules" "${PKGVAR}/rules/catalog.rules" 2>/dev/null || true
fi
if [ ! -f "${PKGETC}/mirror.conf" ] && [ -f "${PKGDEST}/etc/mirror.conf" ]; then
	cp -f "${PKGDEST}/etc/mirror.conf" "${PKGETC}/mirror.conf" 2>/dev/null || true
	chmod 644 "${PKGETC}/mirror.conf" 2>/dev/null || true
fi
if [ ! -f "${PKGETC}/accel.conf" ] && [ -f "${PKGDEST}/etc/accel.conf" ]; then
	cp -f "${PKGDEST}/etc/accel.conf" "${PKGETC}/accel.conf" 2>/dev/null || true
	chmod 644 "${PKGETC}/accel.conf" 2>/dev/null || true
fi
# Unsigned packages cannot declare file capabilities (synopkg 319). Print the
# exact admin command so Package Center / synopkg logs have a copy-paste line.
echo "Threat Prevention: after every install/upgrade, as admin run:" >&2
echo "  sudo /usr/bin/setcap cap_net_raw,cap_net_admin,cap_ipc_lock+ep /var/packages/ThreatPrevention/target/bin/suricata" >&2
echo "  sudo synopkg restart ThreatPrevention" >&2
exit 0
