#!/bin/sh
PKGDEST="${SYNOPKG_PKGDEST:-/var/packages/ThreatPrevention/target}"
PKGVAR="/var/packages/ThreatPrevention/var"
PKGETC="/var/packages/ThreatPrevention/etc"
PIDFILE="${PKGVAR}/suricata.pid"
INGEST_PID="${PKGVAR}/ingest.pid"
TPSWEB_PID="${PKGVAR}/tpsweb.pid"
BIN="${PKGDEST}/bin/suricata"
YAML="${PKGDEST}/etc/suricata/suricata.yaml"
LOGDIR="${PKGVAR}/log"
PYDIR="${PKGDEST}/lib/tps"
PYTHON=""
for c in /usr/bin/python3 /usr/local/bin/python3 python3; do
	if command -v "${c}" >/dev/null 2>&1 || [ -x "${c}" ]; then
		PYTHON="${c}"
		break
	fi
done
[ -n "${PYTHON}" ] || PYTHON="python3"

write_status() {
	mkdir -p "${PKGVAR}"
	echo "$1 ${2:-}" > "${PKGVAR}/engine.status" 2>/dev/null || true
}

read_iface_file() {
	# A root-owned 0600 leftover must not abort start.
	[ -r "${PKGETC}/interface" ] || return 1
	tr -d '\r' < "${PKGETC}/interface" | awk 'NF { print $1; exit }'
}

ensure_mirror_conf() {
	mkdir -p "${PKGETC}"
	if [ ! -f "${PKGETC}/mirror.conf" ] && [ -f "${PKGDEST}/etc/mirror.conf" ]; then
		cp -f "${PKGDEST}/etc/mirror.conf" "${PKGETC}/mirror.conf" 2>/dev/null || true
		chmod 644 "${PKGETC}/mirror.conf" 2>/dev/null || true
	fi
}

mirror_kv() {
	key="$1"
	default="$2"
	if [ ! -r "${PKGETC}/mirror.conf" ]; then
		echo "${default}"
		return
	fi
	awk -F= -v k="${key}" -v d="${default}" '
		BEGIN { found=0 }
		/^[ \t]*#/ { next }
		NF < 1 { next }
		{
			gsub(/^[ \t]+|[ \t]+$/, "", $1)
			if ($1 == k) {
				val=$0
				sub(/^[^=]*=/, "", val)
				gsub(/^[ \t]+|[ \t]+$/, "", val)
				print val
				found=1
				exit
			}
		}
		END { if (!found) print d }
	' "${PKGETC}/mirror.conf"
}

detect_local_ip() {
	router="$1"
	src=""
	if [ -n "${router}" ]; then
		src="$(ip -4 route get "${router}" 2>/dev/null | awk '{
			for (i = 1; i <= NF; i++) if ($i == "src") { print $(i+1); exit }
		}')"
	fi
	if [ -z "${src}" ]; then
		src="$(ip -4 -o addr show ovs_eth0 2>/dev/null | awk '{ print $4; exit }' | cut -d/ -f1)"
	fi
	echo "${src}"
}

pin_iface() {
	name="$1"
	[ -n "${name}" ] || return 0
	echo "${name}" > "${PKGETC}/interface" 2>/dev/null || true
	chmod 644 "${PKGETC}/interface" 2>/dev/null || true
}

ensure_gretap() {
	ensure_mirror_conf
	enabled="$(mirror_kv enabled 0)"
	case "${enabled}" in
		1|yes|true|on) ;;
		*) return 1 ;;
	esac
	ifname="$(mirror_kv ifname tps0)"
	[ -n "${ifname}" ] || ifname="tps0"
	router="$(mirror_kv router_ip 192.168.1.1)"
	local_ip="$(mirror_kv local_ip "")"
	if [ -z "${local_ip}" ]; then
		local_ip="$(detect_local_ip "${router}")"
	fi
	if [ -z "${router}" ] || [ -z "${local_ip}" ]; then
		echo "gretap skipped: need router_ip and local_ip" >&2
		return 1
	fi
	modprobe ip_gre 2>/dev/null || modprobe gre 2>/dev/null || true
	if ip link show "${ifname}" >/dev/null 2>&1; then
		ip link set "${ifname}" up 2>/dev/null || true
		pin_iface "${ifname}"
		echo "gretap ${ifname} already present (remote ${router})" >&2
		return 0
	fi
	if ip link add "${ifname}" type gretap remote "${router}" local "${local_ip}" ttl 255 2>/dev/null; then
		ip link set "${ifname}" up 2>/dev/null || true
		pin_iface "${ifname}"
		echo "gretap ${ifname} ${local_ip} -> ${router}" >&2
		return 0
	fi
	echo "gretap ${ifname} create failed; capture stays on LAN NIC" >&2
	return 1
}

destroy_gretap() {
	ensure_mirror_conf
	ifname="$(mirror_kv ifname tps0)"
	[ -n "${ifname}" ] || ifname="tps0"
	if ip link show "${ifname}" >/dev/null 2>&1; then
		ip link set "${ifname}" down 2>/dev/null || true
		ip link del "${ifname}" 2>/dev/null || true
		echo "gretap ${ifname} removed" >&2
	fi
}

pick_iface() {
	iface="$(read_iface_file || true)"
	if [ -n "${iface}" ]; then
		echo "${iface}"
		return
	fi
	if ip link show ovs_eth0 >/dev/null 2>&1; then
		echo ovs_eth0
		return
	fi
	ip -o link show 2>/dev/null | awk -F': ' '
		$2 ~ /^(lo|sit0|docker|veth|br-|ovs-system)/ { next }
		$0 ~ / master / { next }
		{ print $2; exit }
	' | cut -d'@' -f1
}

alive() {
	[ -f "$1" ] && kill -0 "$(cat "$1" 2>/dev/null)" 2>/dev/null
}

kill_pidfile() {
	if [ -f "$1" ]; then
		kill "$(cat "$1" 2>/dev/null)" 2>/dev/null || true
		rm -f "$1" 2>/dev/null || true
	fi
}

link_webapi() {
	if [ -f "${PKGDEST}/webapi/SYNO.TPS.lib" ]; then
		ln -sf "${PKGDEST}/webapi/SYNO.TPS.lib" /usr/syno/synoman/webapi/SYNO.TPS.lib 2>/dev/null || true
	fi
}

unlink_webapi() {
	rm -f /usr/syno/synoman/webapi/SYNO.TPS.lib 2>/dev/null || true
}

start_helpers() {
	mkdir -p "${PKGVAR}" "${PKGETC}" "${PKGVAR}/export" "${LOGDIR}"
	link_webapi
	if [ ! -f "${PKGETC}/sensor.conf" ] && [ -f "${PKGDEST}/etc/sensor/sensor.conf" ]; then
		cp -f "${PKGDEST}/etc/sensor/sensor.conf" "${PKGETC}/sensor.conf" 2>/dev/null || true
		chmod 644 "${PKGETC}/sensor.conf" 2>/dev/null || true
	fi
	if [ -x "${PYTHON}" ] || command -v "${PYTHON}" >/dev/null 2>&1; then
		if ! alive "${INGEST_PID}"; then
			PYTHONPATH="${PYDIR}" "${PYTHON}" "${PYDIR}/ingest.py" >>"${LOGDIR}/ingest.log" 2>&1 &
			echo $! > "${INGEST_PID}"
		fi
		if ! alive "${TPSWEB_PID}"; then
			PYTHONPATH="${PYDIR}" "${PYTHON}" "${PYDIR}/tpsweb.py" >>"${LOGDIR}/tpsweb.log" 2>&1 &
			echo $! > "${TPSWEB_PID}"
		fi
	else
		echo "python3 missing; tpsweb/ingest not started" >&2
	fi
}

helpers_ok() {
	alive "${TPSWEB_PID}"
}

start() {
	mkdir -p "${LOGDIR}" "${PKGVAR}" "${PKGETC}" "${PKGVAR}/export"
	ensure_gretap || true
	ifname="$(mirror_kv ifname tps0)"
	cur="$(read_iface_file || true)"
	if [ -n "${ifname}" ] && [ "${cur}" = "${ifname}" ] && ! ip link show "${ifname}" >/dev/null 2>&1; then
		echo "capture pin ${ifname} missing; falling back to ovs_eth0" >&2
		pin_iface ovs_eth0
	fi
	# Package Center start must not die on a stale root-owned iface pin.
	IFACE="$(pick_iface)"
	if [ -z "${IFACE}" ]; then
		echo "no capture interface" >&2
		start_helpers
		if helpers_ok; then
			write_status failed ""
			return 0
		fi
		return 1
	fi
	if [ -w "${PKGETC}" ] && [ ! -r "${PKGETC}/interface" ]; then
		echo "${IFACE}" > "${PKGETC}/interface" 2>/dev/null || true
		chmod 644 "${PKGETC}/interface" 2>/dev/null || true
	fi
	if [ -f "${PIDFILE}" ]; then
		oldpid="$(cat "${PIDFILE}" 2>/dev/null || true)"
		if [ -z "${oldpid}" ] || ! kill -0 "${oldpid}" 2>/dev/null; then
			rm -f "${PIDFILE}" 2>/dev/null || true
		elif ! grep -q "\[${oldpid} .*Engine started" "${LOGDIR}/suricata.log" 2>/dev/null; then
			# Still loading rules, or this is the pre-setcap Package Center
			# start that will die on AF_PACKET. Do not reuse it.
			kill "${oldpid}" 2>/dev/null || true
			rm -f "${PIDFILE}" 2>/dev/null || true
			sleep 1
		fi
	fi
	echo "starting suricata on ${IFACE}" >&2
	if command -v setcap >/dev/null 2>&1; then
		setcap cap_net_raw,cap_net_admin,cap_ipc_lock+ep "${BIN}" 2>/dev/null || true
	fi
	chmod 755 "${LOGDIR}" 2>/dev/null || true
	chmod 644 "${LOGDIR}/eve.json" "${LOGDIR}/suricata.log" 2>/dev/null || true
	suricata_ok=0
	if [ -x "${BIN}" ] && [ ! -f "${PIDFILE}" ]; then
		if "${BIN}" -c "${YAML}" --pidfile "${PIDFILE}" -D -i "${IFACE}" \
			-l "${LOGDIR}" --set "af-packet.0.interface=${IFACE}"; then
			i=0
			while [ "${i}" -lt 20 ]; do
				if [ -f "${PIDFILE}" ] && kill -0 "$(cat "${PIDFILE}")" 2>/dev/null; then
					suricata_ok=1
					break
				fi
				sleep 1
				i=$((i + 1))
			done
			# -D can write the pidfile then die on AF_PACKET EPERM.
			if [ "${suricata_ok}" -eq 1 ]; then
				sleep 4
				if ! alive "${PIDFILE}"; then
					echo "suricata exited after daemonize (often missing setcap)" >&2
					suricata_ok=0
					rm -f "${PIDFILE}" 2>/dev/null || true
				fi
			fi
		else
			echo "suricata failed to start (see ${LOGDIR}/suricata.log)" >&2
		fi
	fi
	start_helpers
	if [ "${suricata_ok}" -ne 1 ]; then
		# -D sometimes exits before --pidfile is written; recover a live engine.
		live="$(ps -eo pid,args 2>/dev/null | awk -v b="${BIN}" '$0 ~ b && $0 !~ /awk/ { print $1; exit }')"
		if [ -n "${live}" ] && kill -0 "${live}" 2>/dev/null; then
			echo "${live}" > "${PIDFILE}" 2>/dev/null || true
			suricata_ok=1
		fi
	fi
	if [ "${suricata_ok}" -eq 1 ]; then
		write_status running "${IFACE}"
	else
		write_status failed "${IFACE}"
	fi
	/var/packages/ThreatPrevention/scripts/dsm-help.sh add 2>/dev/null || true
	# tpsweb is what the official ExtJS app needs. AF_PACKET may need a
	# post-install setcap; do not fail Package Center for that.
	if helpers_ok || [ "${suricata_ok}" -eq 1 ]; then
		return 0
	fi
	return 1
}

stop() {
	/var/packages/ThreatPrevention/scripts/dsm-help.sh del 2>/dev/null || true
	unlink_webapi
	kill_pidfile "${INGEST_PID}"
	kill_pidfile "${TPSWEB_PID}"
	if [ -f "${PIDFILE}" ]; then
		kill "$(cat "${PIDFILE}")" 2>/dev/null || true
		rm -f "${PIDFILE}" 2>/dev/null || true
	fi
	killall suricata 2>/dev/null || true
	destroy_gretap
	write_status stopped ""
}

status() {
	if alive "${PIDFILE}" || helpers_ok; then
		exit 0
	fi
	exit 1
}

case "$1" in
	start) start; exit $? ;;
	stop) stop; exit $? ;;
	status) status ;;
	log) exit 1 ;;
	*) exit 1 ;;
esac
