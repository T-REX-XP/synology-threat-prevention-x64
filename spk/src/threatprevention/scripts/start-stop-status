#!/bin/sh
PKGDEST="${SYNOPKG_PKGDEST:-/var/packages/ThreatPrevention/target}"
PKGVAR="/var/packages/ThreatPrevention/var"
PKGETC="/var/packages/ThreatPrevention/etc"
PIDFILE="${PKGVAR}/suricata.pid"
INGEST_PID="${PKGVAR}/ingest.pid"
TPSWEB_PID="${PKGVAR}/tpsweb.pid"
BIN="${PKGDEST}/bin/suricata"
YAML="${PKGDEST}/etc/suricata/suricata.yaml"
LOGDIR="${PKGVAR}/log"
PYDIR="${PKGDEST}/lib/tps"
PYTHON=""
for c in /usr/bin/python3 /usr/local/bin/python3 python3; do
	if command -v "${c}" >/dev/null 2>&1 || [ -x "${c}" ]; then
		PYTHON="${c}"
		break
	fi
done
[ -n "${PYTHON}" ] || PYTHON="python3"

write_status() {
	# Keep status out of target/ui — leftover HTML there was opened as the old custom app.
	mkdir -p "${PKGVAR}"
	echo "$1 ${2:-}" > "${PKGVAR}/engine.status" 2>/dev/null || true
}

pick_iface() {
	if [ -f "${PKGETC}/interface" ]; then
		cat "${PKGETC}/interface"
		return
	fi
	if ip link show ovs_eth0 >/dev/null 2>&1; then
		echo ovs_eth0
		return
	fi
	ip -o link show 2>/dev/null | awk -F': ' '
		$2 ~ /^(lo|sit0|docker|veth|br-|ovs-system)/ { next }
		$0 ~ / master / { next }
		{ print $2; exit }
	' | cut -d'@' -f1
}

alive() {
	[ -f "$1" ] && kill -0 "$(cat "$1" 2>/dev/null)" 2>/dev/null
}

kill_pidfile() {
	if [ -f "$1" ]; then
		kill "$(cat "$1" 2>/dev/null)" 2>/dev/null || true
		rm -f "$1"
	fi
}

link_webapi() {
	# Official start does this as root. Unsigned package user may fail; bridge does not need it.
	if [ -f "${PKGDEST}/webapi/SYNO.TPS.lib" ]; then
		ln -sf "${PKGDEST}/webapi/SYNO.TPS.lib" /usr/syno/synoman/webapi/SYNO.TPS.lib 2>/dev/null || true
	fi
}

unlink_webapi() {
	rm -f /usr/syno/synoman/webapi/SYNO.TPS.lib 2>/dev/null || true
}

start_helpers() {
	mkdir -p "${PKGVAR}" "${PKGETC}"
	link_webapi
	if [ ! -f "${PKGETC}/sensor.conf" ] && [ -f "${PKGDEST}/etc/sensor/sensor.conf" ]; then
		cp -f "${PKGDEST}/etc/sensor/sensor.conf" "${PKGETC}/sensor.conf"
	fi
	if [ -x "${PYTHON}" ] || command -v "${PYTHON}" >/dev/null 2>&1; then
		if ! alive "${INGEST_PID}"; then
			PYTHONPATH="${PYDIR}" "${PYTHON}" "${PYDIR}/ingest.py" >>"${LOGDIR}/ingest.log" 2>&1 &
			echo $! > "${INGEST_PID}"
		fi
		if ! alive "${TPSWEB_PID}"; then
			PYTHONPATH="${PYDIR}" "${PYTHON}" "${PYDIR}/tpsweb.py" >>"${LOGDIR}/tpsweb.log" 2>&1 &
			echo $! > "${TPSWEB_PID}"
		fi
	else
		echo "python3 missing; tpsweb/ingest not started" >&2
	fi
}

start() {
	mkdir -p "${LOGDIR}" "${PKGVAR}" "${PKGETC}"
	if [ ! -x "${BIN}" ]; then
		echo "suricata binary missing" >&2
		return 1
	fi
	IFACE="$(pick_iface)"
	if [ -z "${IFACE}" ]; then
		echo "no capture interface" >&2
		return 1
	fi
	if [ -f "${PIDFILE}" ]; then
		oldpid="$(cat "${PIDFILE}" 2>/dev/null || true)"
		if [ -z "${oldpid}" ] || ! kill -0 "${oldpid}" 2>/dev/null; then
			rm -f "${PIDFILE}"
		fi
	fi
	echo "starting suricata on ${IFACE}" >&2
	if command -v setcap >/dev/null 2>&1; then
		setcap cap_net_raw,cap_net_admin,cap_ipc_lock+ep "${BIN}" 2>/dev/null || true
	fi
	chmod 755 "${LOGDIR}" 2>/dev/null || true
	chmod 644 "${LOGDIR}/eve.json" "${LOGDIR}/suricata.log" 2>/dev/null || true
	if ! "${BIN}" -c "${YAML}" --pidfile "${PIDFILE}" -D -i "${IFACE}" \
		-l "${LOGDIR}" --set "af-packet.0.interface=${IFACE}"; then
		echo "suricata failed to start (see ${LOGDIR}/suricata.log)" >&2
		write_status failed "${IFACE}"
		start_helpers
		return 1
	fi
	i=0
	while [ "${i}" -lt 45 ]; do
		if [ -f "${PIDFILE}" ] && kill -0 "$(cat "${PIDFILE}")" 2>/dev/null; then
			start_helpers
			write_status running "${IFACE}"
			return 0
		fi
		sleep 1
		i=$((i + 1))
	done
	echo "suricata did not daemonize (see ${LOGDIR}/suricata.log)" >&2
	write_status failed "${IFACE}"
	start_helpers
	return 1
}

stop() {
	unlink_webapi
	kill_pidfile "${INGEST_PID}"
	kill_pidfile "${TPSWEB_PID}"
	if [ -f "${PIDFILE}" ]; then
		kill "$(cat "${PIDFILE}")" 2>/dev/null || true
		rm -f "${PIDFILE}"
	fi
	killall suricata 2>/dev/null || true
	write_status stopped ""
}

status() {
	if [ -f "${PIDFILE}" ] && kill -0 "$(cat "${PIDFILE}")" 2>/dev/null; then
		exit 0
	fi
	exit 1
}

case "$1" in
	start) start; exit $? ;;
	stop) stop; exit $? ;;
	status) status ;;
	log) exit 1 ;;
	*) exit 1 ;;
esac
